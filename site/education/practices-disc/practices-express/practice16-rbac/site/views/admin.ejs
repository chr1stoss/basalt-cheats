<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Панель администратора</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f5f5f5;
      display: flex; justify-content: center; align-items: flex-start;
      min-height: 100vh; margin: 0; padding: 40px 16px;
    }
    .card {
      background: #fff; padding: 32px; border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      width: 100%; max-width: 820px;
      border: 1px solid #e5e5e5;
    }
    h1 { color: #1a1a1a; margin: 0 0 8px; font-size: 24px; }
    .sub { color: #666; margin-bottom: 24px; font-size: 14px; }
    .sub strong { color: #1a1a1a; }
    .msg {
      padding: 10px 14px; border-radius: 6px; margin-bottom: 16px;
      font-size: 14px; border: 1px solid #1a1a1a;
      background: #f5f5f5; color: #1a1a1a;
    }
    .msg.err { font-weight: 600; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
    th, td {
      padding: 12px 10px; text-align: left;
      border-bottom: 1px solid #e5e5e5; font-size: 14px;
    }
    th {
      background: #fafafa; color: #4b4b4b;
      text-transform: uppercase; font-size: 12px;
      letter-spacing: 0.05em; font-weight: 600;
    }
    .badge {
      display: inline-block; padding: 3px 10px; border-radius: 999px;
      font-size: 12px; font-weight: 600; border: 1px solid #1a1a1a;
    }
    .badge-admin { background: #1a1a1a; color: #fff; }
    .badge-user  { background: #f5f5f5; color: #1a1a1a; }
    .btn {
      display: inline-block; padding: 8px 16px;
      background: #1a1a1a; color: #fff;
      border: none; border-radius: 6px; font-size: 13px;
      font-weight: 600; cursor: pointer;
    }
    .btn:hover { background: #333; }
    .btn-disabled {
      background: #e5e5e5; color: #888; cursor: not-allowed;
      padding: 8px 16px; border-radius: 6px; font-size: 13px;
    }
    .btn-back {
      display: inline-block; padding: 10px 20px;
      background: transparent; color: #1a1a1a;
      border: 2px solid #1a1a1a; border-radius: 8px;
      font-size: 14px; font-weight: 600; text-decoration: none;
    }
    .btn-back:hover { background: #1a1a1a; color: #fff; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Панель администратора</h1>
    <p class="sub">
      Всего пользователей: <strong><%= users.length %></strong> ·
      Вы вошли как <strong><%= user.username %></strong>
    </p>

    <% if (ok === 'deleted') { %><div class="msg">Пользователь удалён.</div><% } %>
    <% if (err === 'self') { %><div class="msg err">Нельзя удалить собственную учётную запись.</div><% } %>
    <% if (err === 'notfound') { %><div class="msg err">Пользователь не найден.</div><% } %>
    <% if (err === 'invalid') { %><div class="msg err">Некорректный ID.</div><% } %>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Имя пользователя</th>
          <th>Роль</th>
          <th>Действие</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.id %></td>
            <td><%= u.username %></td>
            <td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
            <td>
              <% if (u.id === user.id) { %>
                <span class="btn-disabled">Это вы</span>
              <% } else { %>
                <form action="/admin/delete/<%= u.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn"
                          onclick="return confirm('Удалить пользователя <%= u.username %>?');">
                    Удалить
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <a href="/" class="btn-back">← На главную</a>
  </div>
</body>
</html>